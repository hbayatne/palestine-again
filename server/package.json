{
  "name": "signaldesk-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SignalDesk backend — auth, entitlements, Stripe billing, market-data proxy, signal history, congressional trades.",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "check": "find src -name '*.js' -exec node --check {} +",
    "test": "node --test test/*.test.mjs",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "stripe": "^16.9.0"
  }
}
