# Copy to .env and fill in. NEVER commit .env.
# ---- required ----
DATABASE_URL=postgres://user:pass@host:5432/signaldesk
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
APP_BASE_URL=https://hbayatne.github.io/palestine-again
CORS_ORIGIN=https://hbayatne.github.io
PORT=8080
NODE_ENV=production

# ---- Stripe (billing). Leave blank to run without billing. ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LITE=
STRIPE_PRICE_PRO=

# ---- market data (optional) ----
# Server-held FMP key so it never ships to the browser.
FMP_API_KEY=
